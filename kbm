-- ==========================================
-- TUŞ VE FARE DİNLEYİCİLERİ
-- ==========================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.F6 then
        toggleMenu()
        return
    end
    if gameProcessed then return end

    if input.UserInputType == Enum.UserInputType.MouseButton4
    or input.UserInputType == Enum.UserInputType.MouseButton5
    or input.KeyCode == Enum.KeyCode.R then
        acEnabled = not acEnabled
        updateAcVisual(acEnabled)
        miniHud.Visible = acEnabled
    end

    if shiftLockSystem and input.KeyCode == Enum.KeyCode.LeftShift then
        if not shiftLockActive then
            shiftLockActive = true
            crosshair.Visible = true
            local _, y, _ = camera.CFrame:ToEulerAnglesYXZ()
            yaw, pitch = y, 0
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            UserInputService.MouseIconEnabled = false
        else
            disableShiftLock()
        end
    end

    if rmbFixEnabled and not shiftLockActive and input.UserInputType == Enum.UserInputType.MouseButton2 then
        sagTikBasili = true
        baslangicPos = UserInputService:GetMouseLocation()
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if rmbFixEnabled and sagTikBasili and input.UserInputType == Enum.UserInputType.MouseButton2 then
        sagTikBasili = false
        if not shiftLockActive then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            VirtualInputManager:SendMouseMoveEvent(baslangicPos.X, baslangicPos.Y, game)
        end
    end
end)

UserInputService.InputChanged:Connect(function(input, gameProcessed)
    if not shiftLockActive then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        yaw = yaw - (input.Delta.X * sens)
        pitch = math.clamp(pitch - (input.Delta.Y * sens), math.rad(-75), math.rad(75))
    elseif input.UserInputType == Enum.UserInputType.MouseWheel and not gameProcessed then
        camDist = math.clamp(camDist - (input.Position.Z * 1.5), 4, 20)
    end
end)

-- ==========================================
-- ANA DÖNGÜLER (Kamera + Görüş Desteği + Auto Clicker)
-- ==========================================
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

RunService.RenderStepped:Connect(function()
    -- 1. Özel Shift Lock & Sağ Tık Koruması
    if shiftLockActive then
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if root and hum and hum.Health > 0 then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            hum.AutoRotate = false
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)

            camera.CameraType = Enum.CameraType.Scriptable
            local rot = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
            local origin = root.Position + Vector3.new(0, 1.5, 0) + (rot * Vector3.new(1.75, 0.5, 0))
            local desiredCFrame = CFrame.new(origin) * rot * CFrame.new(0, 0, camDist)

            rayParams.FilterDescendantsInstances = {char}
            local direction = desiredCFrame.Position - origin
            local result = workspace:Raycast(origin, direction, rayParams)
            if result then
                camera.CFrame = CFrame.new(result.Position - (direction.Unit * 0.5)) * rot
            else
                camera.CFrame = desiredCFrame
            end
        end
    elseif rmbFixEnabled and sagTikBasili then
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
    end

    -- 2. Akıllı Görüş Desteği (İskelet + İsim/Mesafe)
    if visualAssist and hasDrawing then
        local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        for plr, data in pairs(visualsCache) do
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local head = char and char:FindFirstChild("Head")
            local root = char and char:FindFirstChild("HumanoidRootPart")

            if char and hum and hum.Health > 0 and head and root then
                local distStuds = myRoot and (myRoot.Position - root.Position).Magnitude or (camera.CFrame.Position - root.Position).Magnitude
                local distMeters = math.floor(distStuds * 0.28) -- Stud -> Metre dönüşümü

                -- Yakınlık akıllı solma: 25m altında iskelet yumuşakça şeffaflaşır (görünümü bozmaz)
                local skelAlpha = math.clamp((distMeters - 6) / 22, 0.12, 0.72)
                local textAlpha = math.clamp((distMeters - 3) / 15, 0.35, 0.90)

                -- İsim ve Mesafe Etiketi
                local headPos, onScreen = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.8, 0))
                if onScreen then
                    data.label.Position = Vector2.new(headPos.X, headPos.Y)
                    data.label.Text = string.format("%s [%dm]", plr.DisplayName, distMeters)
                    data.label.Transparency = textAlpha
                    data.label.Visible = true
                else
                    data.label.Visible = false
                end

                -- İskelet Çizgileri (R15 / R6 Otomatik)
                local boneList = char:FindFirstChild("UpperTorso") and bonesR15 or bonesR6
                for i, line in ipairs(data.lines) do
                    local pair = boneList[i]
                    if pair then
                        local p1 = char:FindFirstChild(pair[1])
                        local p2 = char:FindFirstChild(pair[2])
                        if p1 and p2 then
                            local v1, vis1 = camera:WorldToViewportPoint(p1.Position)
                            local v2, vis2 = camera:WorldToViewportPoint(p2.Position)
                            if vis1 and vis2 then
                                line.From = Vector2.new(v1.X, v1.Y)
                                line.To = Vector2.new(v2.X, v2.Y)
                                line.Transparency = skelAlpha
                                line.Visible = true
                            else
                                line.Visible = false
                            end
                        else
                            line.Visible = false
                        end
                    else
                        line.Visible = false
                    end
                end
            else
                for _, line in ipairs(data.lines) do line.Visible = false end
                data.label.Visible = false
            end
        end
    end
end)

-- Dinamik Auto Clicker Döngüsü
task.spawn(function()
    while true do
        if acEnabled then
            local pos = UserInputService:GetMouseLocation()
            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
            task.wait(0.01)
            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
            task.wait(acDelay + (math.random() * 0.015))
        else
            task.wait(0.05)
        end
    end
end)
