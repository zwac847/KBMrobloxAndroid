local function tweenObj(obj, props, duration)
    TweenService:Create(obj, TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props):Play()
end

local function toggleMenu()
    menuAcik = not menuAcik
    if menuAcik then
        mainFrame.Visible = true
        tweenObj(mainFrame, {Size = UDim2.new(0, 300, 0, 330)}, 0.25)
    else
        local t = TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.new(0, 300, 0, 0)})
        t:Play()
        t.Completed:Connect(function()
            if not menuAcik then mainFrame.Visible = false end
        end)
    end
end
floatBtn.MouseButton1Click:Connect(toggleMenu)

