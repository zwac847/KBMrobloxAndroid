local hasDrawing = pcall(function() return Drawing.new end)
local visualsCache = {}

local bonesR15 = {
    {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"}
}

local bonesR6 = {
    {"Head", "Torso"},
    {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
    {"Torso", "Left Leg"}, {"Torso", "Right Leg"}
}

local function clearVisualFor(plr)
    local data = visualsCache[plr]
    if data then
        for _, line in ipairs(data.lines) do line:Remove() end
        data.label:Remove()
        visualsCache[plr] = nil
    end
end

local function createVisualFor(plr)
    if not hasDrawing or plr == player then return end
    clearVisualFor(plr)

    local lines = {}
    for i = 1, 14 do
        local l = Drawing.new("Line")
        l.Thickness = 1.25
        l.Color = Color3.fromRGB(165, 225, 255) -- Göz yormayan soft buz mavisi
        l.Transparency = 0.75
        l.Visible = false
        lines[i] = l
    end

    local lbl = Drawing.new("Text")
    lbl.Size = 13
    lbl.Center = true
    lbl.Outline = true
    lbl.OutlineColor = Color3.fromRGB(10, 10, 15)
    lbl.Color = Color3.fromRGB(235, 240, 250)
    lbl.Visible = false

    visualsCache[plr] = {lines = lines, label = lbl}
end

local function hideAllVisuals()
    for _, data in pairs(visualsCache) do
        for _, line in ipairs(data.lines) do line.Visible = false end
        data.label.Visible = false
    end
end

for _, plr in ipairs(Players:GetPlayers()) do createVisualFor(plr) end
Players.PlayerAdded:Connect(createVisualFor)
Players.PlayerRemoving:Connect(clearVisualFor)

