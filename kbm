-- ==========================================
-- GUI BUTONLARINI BAĞLA
-- ==========================================
local updateAcVisual = createToggle("Auto Clicker [R / Yan Tuş]", acEnabled, function(state)
    acEnabled = state
    miniHud.Visible = state
end)

createStepper("Tıklama Gecikmesi", string.format("%.3fs", acDelay), function()
    acDelay = math.clamp(acDelay - 0.005, 0.015, 0.25)
    return string.format("%.3fs", acDelay)
end, function()
    acDelay = math.clamp(acDelay + 0.005, 0.015, 0.25)
    return string.format("%.3fs", acDelay)
end)

createToggle("Sağ Tık Işınlanma Önle", rmbFixEnabled, function(state)
    rmbFixEnabled = state
end)

createToggle("Özel Shift Lock [L-Shift]", shiftLockSystem, function(state)
    shiftLockSystem = state
    if not state and shiftLockActive then
        shiftLockActive = false
        crosshair.Visible = false
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        UserInputService.MouseIconEnabled = true
        camera.CameraType = Enum.CameraType.Custom
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.AutoRotate = true end
    end
end)

createStepper("Shift Lock Hassasiyet", string.format("%.4f", sens), function()
    sens = math.clamp(sens - 0.0005, 0.001, 0.015)
    return string.format("%.4f", sens)
end, function()
    sens = math.clamp(sens + 0.0005, 0.001, 0.015)
    return string.format("%.4f", sens)
end)

-- ==========================================
-- TUŞ DİNLEYİCİLERİ (F6, R/Yan Tuş, Shift, Sağ Tık)
-- ==========================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    -- F6 ile GUI Gizle / Göster
    if input.KeyCode == Enum.KeyCode.F6 then
        menuAcik = not menuAcik
        mainFrame.Visible = menuAcik
        return
    end

    if gameProcessed then return end

    -- Auto Clicker Tetikleyici (R veya Farenin Yan Tuşu)
    if input.UserInputType == Enum.UserInputType.MouseButton4
    or input.UserInputType == Enum.UserInputType.MouseButton5
    or input.KeyCode == Enum.KeyCode.R then
        acEnabled = not acEnabled
        updateAcVisual(acEnabled)
        miniHud.Visible = acEnabled
    end

    -- Özel Shift Lock Aç/Kapa (LeftShift)
    if shiftLockSystem and input.KeyCode == Enum.KeyCode.LeftShift then
        shiftLockActive = not shiftLockActive
        crosshair.Visible = shiftLockActive
        if shiftLockActive then
            local _, y, _ = camera.CFrame:ToEulerAnglesYXZ()
            yaw, pitch = y, 0
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            UserInputService.MouseIconEnabled = false
        else
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
            camera.CameraType = Enum.CameraType.Custom
            local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.AutoRotate = true end
        end
    end

    -- Sağ Tık Işınlanma Önleyici Başlangıç
    if rmbFixEnabled and not shiftLockActive and input.UserInputType == Enum.UserInputType.MouseButton2 then
        sagTikBasili = true
        baslangicPos = UserInputService:GetMouseLocation()
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
    end
end)

UserInputService.InputEnded:Connect(function(input)
    -- Sağ Tık Bırakıldığında İmleci Eski Konuma Geri Çek
    if rmbFixEnabled and sagTikBasili and input.UserInputType == Enum.UserInputType.MouseButton2 then
        sagTikBasili = false
        if not shiftLockActive then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            VirtualInputManager:SendMouseMoveEvent(baslangicPos.X, baslangicPos.Y, game)
        end
    end
end)

-- Shift Lock Fare Hareketi (Delta)
UserInputService.InputChanged:Connect(function(input)
    if shiftLockActive and input.UserInputType == Enum.UserInputType.MouseMovement then
        yaw = yaw - (input.Delta.X * sens)
        pitch = math.clamp(pitch - (input.Delta.Y * sens), math.rad(-75), math.rad(75))
    end
end)

-- ==========================================
-- ANA DÖNGÜLER (Kamera & Auto Clicker)
-- ==========================================
RunService.RenderStepped:Connect(function()
    if shiftLockActive then
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if root and hum then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            hum.AutoRotate = false
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
            
            camera.CameraType = Enum.CameraType.Scriptable
            local rot = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
            local offset = root.Position + Vector3.new(0, 1.5, 0) + (rot * Vector3.new(1.75, 0.5, 0))
            local dist = math.clamp((camera.CFrame.Position - root.Position).Magnitude, 6, 14)
            camera.CFrame = CFrame.new(offset) * rot * CFrame.new(0, 0, dist)
        end
    elseif rmbFixEnabled and sagTikBasili then
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
    end
end)

-- Dinamik Auto Clicker Döngüsü
task.spawn(function()
    while true do
        if acEnabled then
            local pos = UserInputService:GetMouseLocation()
            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
            task.wait(0.01)
            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
            
            -- Doğal rastgele sapma ekle (anti-detect)
            local jitter = (math.random() * 0.015)
            task.wait(acDelay + jitter)
        else
            task.wait(0.05)
        end
    end
end)
